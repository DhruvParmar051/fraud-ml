# ── MLflow ───────────────────────────────────────────────
# NOTE: host port is 5050, not 5000 — macOS Control Center holds 5000.
MLFLOW_TRACKING_URI=http://localhost:5050

# ── MinIO (S3-compatible artifact store) ─────────────────
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# ── Redis (online feature store) ─────────────────────────
REDIS_URL=redis://localhost:6379

# ── Weights & Biases ─────────────────────────────────────
WANDB_API_KEY=your_key_here
WANDB_PROJECT=fraud-detection

# ── Feast feature store ──────────────────────────────────
FEAST_REPO_PATH=src/features/feature_repo/

# ── Kafka / Redpanda ─────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TRANSACTIONS=transactions.raw
KAFKA_CONSUMER_GROUP=fraud-feature-consumer
