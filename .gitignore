# ── Data ────────────────────────────────────────────────
# PaySim CSV is ~470MB and Parquet outputs are large.
# Never commit data — it bloats the repo and GitHub rejects >100MB files.
data/raw/*
data/processed/*
data/reference/*
data/predictions/*
# ...but keep the empty folders in the repo so the structure is visible:
!data/raw/.gitkeep
!data/processed/.gitkeep

# ── Secrets ─────────────────────────────────────────────
.env

# ── Python ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# ── Virtual environments ────────────────────────────────
.venv/
venv/

# ── Tooling caches ──────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ── ML artifacts (generated, not source) ────────────────
mlruns/
mlflow.db
wandb/
reports/

# ── Feast generated store ───────────────────────────────
src/features/feature_repo/data/

# ── OS / IDE ────────────────────────────────────────────
.DS_Store
.vscode/
.idea/